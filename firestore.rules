rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /rooms/{roomId} {
   function signed() { return request.auth != null; }
   function id() { return request.auth.uid; }
   function oldP() { return resource.data.players; }
   function newP() { return request.resource.data.players; }
   function member() { return signed() && id() in oldP(); }
   function player(p) {
    return p is map && p.keys().hasAll(['name','ready'])
      && p.keys().hasOnly(['name','ready'])
      && p.name is string && p.name.size() >= 2 && p.name.size() <= 20
      && p.ready is bool;
   }
   function fieldsOnly(keys) {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
   }
   function allReady() {
    return oldP().values()[0].ready == true
      && (oldP().size() < 2 || oldP().values()[1].ready == true)
      && (oldP().size() < 3 || oldP().values()[2].ready == true)
      && (oldP().size() < 4 || oldP().values()[3].ready == true);
   }
   function validPlayer(p) {
    return p is map && p.cash is number && p.pos is int && p.pos >= 0 && p.pos < 32
      && p.jail is int && p.jail >= 0 && p.jail <= 3 && p.bankrupt is bool
      && p.name is string;
   }
   function validState(s) {
    return s is map && s.version == 2
      && s.playerIds is list && s.playerIds == oldP().keys()
      && s.players is list && s.players.size() == oldP().size()
      && validPlayer(s.players[0]) && validPlayer(s.players[1])
      && (s.players.size() < 3 || validPlayer(s.players[2]))
      && (s.players.size() < 4 || validPlayer(s.players[3]))
      && s.players[0].name == oldP()[s.playerIds[0]].name
      && s.players[1].name == oldP()[s.playerIds[1]].name
      && (s.players.size() < 3 || s.players[2].name == oldP()[s.playerIds[2]].name)
      && (s.players.size() < 4 || s.players[3].name == oldP()[s.playerIds[3]].name)
      && s.properties is list && s.properties.size() == 32
      && s.current is int && s.current >= 0 && s.current < oldP().size()
      && s.phase in ['roll','end','purchase','jail-choice','debt','wheel','casino',
        'rob','rob-penalty','deal','offer-response','exchange-response','exchange-pick','gameover']
      && s.goal == resource.data.goal && s.deadline is number
      && s.roll is int && s.roll >= 0 && s.roll <= 6
      && s.loot is number && s.loot >= 0 && s.extraTurn is bool && s.gameOver is bool
      && s.logs is list && s.logs.size() <= 30
      && (s.pending == null || (s.pending is map && s.pending.actor is int
        && s.pending.actor >= 0 && s.pending.actor < oldP().size()
        && s.pending.type == s.phase))
      && s.lastActionId is string && s.lastActionId.size() <= 200;
   }
   function activeActor(s) {
    return s.get('pending', null) is map
      ? s.pending.get('actor', s.current) : s.current;
   }
   function mayAdvance(before, after) {
    return !before.gameOver && after.deadline == before.deadline && (
      oldP().keys()[activeActor(before)] == id()
      || (after.lastAction.type == 'quit' && after.lastAction.uid == id()
        && before.players[after.lastAction.player].bankrupt == false
        && after.players[after.lastAction.player].bankrupt == true
        && oldP().keys()[after.lastAction.player] == id())
      || (after.lastAction.type == 'timeout' && before.deadline > 0
        && request.time.toMillis() >= before.deadline && after.gameOver == true)
    );
   }
   allow get: if signed() && roomId.matches('[A-HJ-NP-Z2-9]{6}');
   allow list, delete: if false;
   allow create: if signed() && roomId.matches('[A-HJ-NP-Z2-9]{6}')
     && request.resource.data.keys().hasOnly(['host','status','goal','duration','createdAt','players'])
     && request.resource.data.keys().hasAll(['host','status','goal','duration','createdAt','players'])
     && request.resource.data.host == id()
     && request.resource.data.status == 'waiting'
     && request.resource.data.goal == 3000
     && request.resource.data.duration == 0
     && request.resource.data.createdAt == request.time
     && request.resource.data.players is map
     && request.resource.data.players.size() == 1
     && id() in request.resource.data.players
     && player(request.resource.data.players[id()])
     && request.resource.data.players[id()].ready == false;
   allow update: if signed() && (
     (
       resource.data.status == 'waiting' && !member()
       && fieldsOnly(['players'])
       && newP().size() == oldP().size() + 1 && newP().size() <= 4
       && newP().diff(oldP()).addedKeys().hasOnly([id()])
       && newP().diff(oldP()).addedKeys().hasAll([id()])
       && newP().diff(oldP()).changedKeys().size() == 0
       && newP().diff(oldP()).removedKeys().size() == 0
       && player(newP()[id()]) && newP()[id()].ready == false
     ) || (
       resource.data.status == 'waiting' && member()
       && fieldsOnly(['players'])
       && newP().size() == oldP().size()
       && newP().diff(oldP()).affectedKeys().hasOnly([id()])
       && newP()[id()].name == oldP()[id()].name
       && player(newP()[id()])
     ) || (
       member() && resource.data.host == id()
       && resource.data.status == 'waiting'
       && fieldsOnly(['status','goal','duration','startedAt'])
       && request.resource.data.status == 'playing'
       && oldP().size() >= 2 && oldP().size() <= 4
       && allReady()
       && request.resource.data.goal in [2000,3000]
       && request.resource.data.duration in [0,10,15,20,30]
       && request.resource.data.startedAt == request.time
     ) || (
       member() && resource.data.status == 'playing'
       && fieldsOnly(['gameState','gameRevision'])
       && validState(request.resource.data.gameState)
       && request.resource.data.gameRevision is int
       && request.resource.data.gameRevision == resource.data.get('gameRevision', 0) + 1
       && (
         (!('gameState' in resource.data) && resource.data.host == id()
           && request.resource.data.gameState.current == 0
           && request.resource.data.gameState.phase == 'roll')
         || ('gameState' in resource.data
           && mayAdvance(resource.data.gameState, request.resource.data.gameState))
       )
     ) || (
       resource.data.status == 'waiting' && member() && oldP().size() > 1
       && fieldsOnly(['players','host'])
       && newP().size() == oldP().size() - 1
       && newP().diff(oldP()).removedKeys().hasOnly([id()])
       && newP().diff(oldP()).removedKeys().hasAll([id()])
       && newP().diff(oldP()).addedKeys().size() == 0
       && newP().diff(oldP()).changedKeys().size() == 0
       && request.resource.data.host in newP().keys()
       && (resource.data.host == id() || request.resource.data.host == resource.data.host)
     ) || (
       resource.data.status == 'waiting' && member() && oldP().size() == 1 && resource.data.host == id()
       && fieldsOnly(['status','players'])
       && request.resource.data.status == 'closed'
       && newP().size() == 0
     )
   );
  }
 }
}
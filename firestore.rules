rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /rooms/{roomId} {
   function signed() { return request.auth != null; }
   function id() { return request.auth.uid; }
   function oldP() { return resource.data.players; }
   function newP() { return request.resource.data.players; }
   function member() { return signed() && id() in oldP(); }
   function player(p) {
    return p is map && p.keys().hasAll(['name','ready'])
      && p.keys().hasOnly(['name','ready'])
      && p.name is string && p.name.size() >= 2 && p.name.size() <= 20
      && p.ready is bool;
   }
   function fieldsOnly(keys) {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
   }
   function allReady() {
    return oldP().values()[0].ready == true
      && (oldP().size() < 2 || oldP().values()[1].ready == true)
      && (oldP().size() < 3 || oldP().values()[2].ready == true)
      && (oldP().size() < 4 || oldP().values()[3].ready == true);
   }
   allow get: if signed() && roomId.matches('[A-HJ-NP-Z2-9]{6}');
   allow list, delete: if false;
   allow create: if signed() && roomId.matches('[A-HJ-NP-Z2-9]{6}')
     && request.resource.data.keys().hasOnly(['host','status','goal','duration','createdAt','players'])
     && request.resource.data.keys().hasAll(['host','status','goal','duration','createdAt','players'])
     && request.resource.data.host == id()
     && request.resource.data.status == 'waiting'
     && request.resource.data.goal == 3000
     && request.resource.data.duration == 0
     && request.resource.data.createdAt == request.time
     && request.resource.data.players is map
     && request.resource.data.players.size() == 1
     && id() in request.resource.data.players
     && player(request.resource.data.players[id()])
     && request.resource.data.players[id()].ready == false;
   allow update: if signed() && (
     (
       resource.data.status == 'waiting' && !member()
       && fieldsOnly(['players'])
       && newP().size() == oldP().size() + 1 && newP().size() <= 4
       && newP().diff(oldP()).addedKeys().hasOnly([id()])
       && newP().diff(oldP()).addedKeys().hasAll([id()])
       && newP().diff(oldP()).changedKeys().size() == 0
       && newP().diff(oldP()).removedKeys().size() == 0
       && player(newP()[id()]) && newP()[id()].ready == false
     ) || (
       resource.data.status == 'waiting' && member()
       && fieldsOnly(['players'])
       && newP().size() == oldP().size()
       && newP().diff(oldP()).affectedKeys().hasOnly([id()])
       && newP()[id()].name == oldP()[id()].name
       && player(newP()[id()])
     ) || (
       member() && resource.data.host == id()
       && resource.data.status == 'waiting'
       && fieldsOnly(['status','goal','duration','startedAt'])
       && request.resource.data.status == 'playing'
       && oldP().size() >= 2 && oldP().size() <= 4
       && allReady()
       && request.resource.data.goal in [2000,3000]
       && request.resource.data.duration in [0,10,15,20,30]
       && request.resource.data.startedAt == request.time
     ) || (
       // Online gameplay prototype: only the player whose turn is active may
       // publish a bounded full-board snapshot. Future server validation required.
       member() && resource.data.status == 'playing'
       && fieldsOnly(['gameState','gameRevision'])
       && request.resource.data.gameState is map
       && request.resource.data.gameState.keys().hasAll(['players','properties','current','phase','roll','loot','extraTurn','goal','deadline','gameOver','logs'])
       && request.resource.data.gameState.players is list
       && request.resource.data.gameState.players.size() == oldP().size()
       && request.resource.data.gameState.properties is list
       && request.resource.data.gameState.properties.size() == 32
       && request.resource.data.gameState.current is int
       && request.resource.data.gameState.current >= 0
       && request.resource.data.gameState.current < oldP().size()
       && request.resource.data.gameRevision is int
       && request.resource.data.gameRevision == resource.data.get('gameRevision', 0) + 1
       && (
         (!('gameState' in resource.data) && resource.data.host == id()
           && request.resource.data.gameState.current == 0)
         || ('gameState' in resource.data
           && oldP().keys()[resource.data.gameState.current] == id()
           && (
             request.resource.data.gameState.current == resource.data.gameState.current
             || request.resource.data.gameState.current == ((resource.data.gameState.current + 1) % oldP().size())
           ))
       )
     ) || (
       // Only the current player can advance the shared turn.
       member() && resource.data.status == 'playing'
       && fieldsOnly(['turnIndex'])
       && request.resource.data.turnIndex is int
       && request.resource.data.turnIndex >= 0
       && request.resource.data.turnIndex < oldP().size()
       && request.resource.data.turnIndex == ((resource.data.get('turnIndex', 0) + 1) % oldP().size())
       && oldP().keys()[resource.data.get('turnIndex', 0) % oldP().size()] == id()
     ) || (
       member() && oldP().size() > 1
       && fieldsOnly(['players','host'])
       && newP().size() == oldP().size() - 1
       && newP().diff(oldP()).removedKeys().hasOnly([id()])
       && newP().diff(oldP()).removedKeys().hasAll([id()])
       && newP().diff(oldP()).addedKeys().size() == 0
       && newP().diff(oldP()).changedKeys().size() == 0
       && request.resource.data.host in newP().keys()
       && (resource.data.host == id() || request.resource.data.host == resource.data.host)
     ) || (
       member() && oldP().size() == 1 && resource.data.host == id()
       && fieldsOnly(['status','players'])
       && request.resource.data.status == 'closed'
       && newP().size() == 0
     )
   );
  }
 }
}
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /rooms/{roomId} {
   function signed() { return request.auth != null; }
   function oldPlayers() { return resource.data.players; }
   function newPlayers() { return request.resource.data.players; }
   function host() { return signed() && resource.data.host == request.auth.uid; }
   function existingMember() { return signed() && request.auth.uid in oldPlayers(); }
   function joinOnly() {
    return signed() && resource.data.status == 'waiting'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
      && request.auth.uid in newPlayers()
      && newPlayers().keys().size() <= 4
      && newPlayers().diff(oldPlayers()).affectedKeys().hasOnly([request.auth.uid])
      && newPlayers()[request.auth.uid].keys().hasOnly(['name','ready'])
      && newPlayers()[request.auth.uid].name is string
      && newPlayers()[request.auth.uid].name.size() >= 2
      && newPlayers()[request.auth.uid].name.size() <= 20
      && newPlayers()[request.auth.uid].ready is bool;
   }
   function hostStart() {
    return host() && resource.data.status == 'waiting'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','goal','duration','startedAt'])
      && request.resource.data.status == 'playing'
      && oldPlayers().keys().size() >= 2
      && oldPlayers().keys().size() <= 4
      && oldPlayers().values().all(p,p.ready == true)
      && request.resource.data.goal in [2000,3000]
      && request.resource.data.duration in [0,10,15,20,30];
   }
   allow create: if signed() && request.resource.data.host == request.auth.uid
      && request.resource.data.status == 'waiting'
      && request.resource.data.players.keys().size() == 1
      && request.auth.uid in request.resource.data.players;
   allow get: if signed();
   allow list: if false;
   allow update: if joinOnly() || hostStart();
   allow delete: if false;
  }
 }
}
